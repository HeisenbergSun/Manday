# Manday 后端环境变量模板（复制为 .env 后由管理员填写）
# ---- 数据库 / 缓存 ----
DATABASE_URL=postgres://manday:***@db-primary:5432/manday
REDIS_URL=redis://redis:6379

# ---- Scania WorkBuddy 企业版 AI 集成（仅服务端持有）----
WORKBUDDY_AI_BASE_URL=https://workbuddy.internal.example.com
WORKBUDDY_AI_API_KEY=<由 WorkBuddy 企业版管理员签发的服务间凭证>
WORKBUDDY_AI_MODEL=workbuddy-default

# ---- 应用 ----
PORT=3000
CORS_ORIGIN=https://manday.internal.example.com
JWT_SECRET=<SSO 会话签名密钥>
