# Manday 后端环境变量模板（复制为 .env 后由管理员填写）
# ---- 数据库 / 缓存 ----
DATABASE_URL=postgres://manday:***@db-primary:5432/manday
REDIS_URL=redis://redis:6379

# ---- Scania WorkBuddy 企业版 AI 集成（CodeBuddy 专享版 cloudhosted）----
WORKBUDDY_AI_API_KEY=<由 Scania WorkBuddy 企业版签发的 API Key（ck_ 开头）>
WORKBUDDY_AI_BASE_URL=https://scania.copilot.qq.com
# WORKBUDDY_AI_MODEL 不设置 = 用企业默认模型（auto）

# ---- 应用 ----
PORT=3000
CORS_ORIGIN=https://manday.internal.example.com
JWT_SECRET=<SSO 会话签名密钥>
